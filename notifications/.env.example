# Never commit real provider credentials. The default is always mock/dry-run.
FUMAI_DB_PATH=./var/fumai-notifications.sqlite3
FUMAI_NOTIFICATION_MODE=mock
FUMAI_EMAIL_PROVIDER=mock
FUMAI_SMS_PROVIDER=mock
FUMAI_NOTIFICATION_PORT=8787
FUMAI_PUBLIC_ORIGIN=http://127.0.0.1:8787
FUMAI_SESSION_HOURS=12
FUMAI_SELF_REGISTRATION=true
# Only used once when app_user is empty. Put the real password in the server secret file, never in Git.
# FUMAI_BOOTSTRAP_ADMIN_USERNAME=admin
# FUMAI_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
FUMAI_WORKER_ID=worker-local-1
FUMAI_WORKER_CONCURRENCY=4
FUMAI_WORKER_LEASE_SECONDS=60
FUMAI_WORKER_MAX_ATTEMPTS=5

# SMTP over implicit TLS (normally port 465)
# FUMAI_EMAIL_PROVIDER=smtp
# FUMAI_SMTP_HOST=smtp.example.com
# FUMAI_SMTP_PORT=465
# FUMAI_SMTP_SECURE=true
# FUMAI_SMTP_USER=noreply@example.com
# FUMAI_SMTP_PASSWORD=server-secret-only
# FUMAI_SMTP_FROM=伏脉智维 <noreply@example.com>

# USB/serial SMS modem managed by gammu-smsd
# FUMAI_SMS_PROVIDER=gammu
# FUMAI_GAMMU_COMMAND=/usr/bin/gammu-smsd-inject
# FUMAI_GAMMU_CONFIG=/etc/gammu-smsdrc
# FUMAI_PROVIDER_TIMEOUT_MS=10000

# Optional SMTP test allowlist; blocked recipients are never sent or marked successful.
# FUMAI_EMAIL_TEST_RECIPIENTS=test@example.com

# On first activation, do not automatically deliver historical mock/demo outbox.
# FUMAI_EMAIL_START_AT=2026-10-23T00:00:00.000Z
# FUMAI_EMAIL_REGISTERED_ONLY=true

# Optional model-service credential. Generate on the server and keep in its 0600 environment file.
# Only authorizes POST /api/model-ingestions and GET /api/model-ingestions/:request_id.
# Use loopback/SSH private transport until the public site has HTTPS.
# FUMAI_MODEL_INGEST_TOKEN=replace-with-at-least-32-random-characters
